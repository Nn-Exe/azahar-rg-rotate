<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            RG Rotate build: allow `simpleperf` to sample this release build from the adb shell,
            so CPU hotspots can be measured on the device instead of guessed at. This does not
            make the app debuggable and has no effect on performance when nothing is profiling.
        -->
        <profileable android:shell="true" />
    </application>

</manifest>
